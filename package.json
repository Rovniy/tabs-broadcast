{
  "name": "tabs-broadcast",
  "amdName": "tabs-broadcast",
  "version": "3.3.0",
  "description": "Library for managing inter-tab communication",
  "main": "dist/tabs-broadcast.umd.js",
  "module": "dist/tabs-broadcast.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run types:check",
    "types:check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rovniy/tabs-broadcast.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/tabs-broadcast.es.js",
      "require": "./dist/tabs-broadcast.umd.js",
	  "types": "./dist/index.d.ts"
	}
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "events",
    "eventemitter",
    "pubsub",
    "broadcast",
    "tabs",
    "communication"
  ],
  "authors": [
    "Andrei (Ravy) Rovnyi <contact@ravy.pro>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rovniy/tabs-broadcast/issues"
  },
  "homepage": "https://ravy.pro",
  "devDependencies": {
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
